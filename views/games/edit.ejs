<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <title>Edit Game</title>
</head>

<body>

  <a href="/games">Back to Games</a>

  <h1>Edit Game</h1>

  <form action="/games/<%= game._id %>?_method=PUT" method="POST">

    <label for="homeTeam">Home Team</label>
    <select id="homeTeam" name="homeTeam">

      <option value="Boston Celtics"
        <%= game.homeTeam === "Boston Celtics" ? "selected" : "" %>>
        Boston Celtics
      </option>

      <option value="Los Angeles Lakers"
        <%= game.homeTeam === "Los Angeles Lakers" ? "selected" : "" %>>
        Los Angeles Lakers
      </option>

      <option value="Golden State Warriors"
        <%= game.homeTeam === "Golden State Warriors" ? "selected" : "" %>>
        Golden State Warriors
      </option>

      <option value="Miami Heat"
        <%= game.homeTeam === "Miami Heat" ? "selected" : "" %>>
        Miami Heat
      </option>

      <option value="Chicago Bulls"
        <%= game.homeTeam === "Chicago Bulls" ? "selected" : "" %>>
        Chicago Bulls
      </option>

      <option value="New York Knicks"
        <%= game.homeTeam === "New York Knicks" ? "selected" : "" %>>
        New York Knicks
      </option>

    </select>


    <label for="awayTeam">Away Team</label>
    <select id="awayTeam" name="awayTeam">

      <option value="Boston Celtics"
        <%= game.awayTeam === "Boston Celtics" ? "selected" : "" %>>
        Boston Celtics
      </option>

      <option value="Los Angeles Lakers"
        <%= game.awayTeam === "Los Angeles Lakers" ? "selected" : "" %>>
        Los Angeles Lakers
      </option>

      <option value="Golden State Warriors"
        <%= game.awayTeam === "Golden State Warriors" ? "selected" : "" %>>
        Golden State Warriors
      </option>

      <option value="Miami Heat"
        <%= game.awayTeam === "Miami Heat" ? "selected" : "" %>>
        Miami Heat
      </option>

      <option value="Chicago Bulls"
        <%= game.awayTeam === "Chicago Bulls" ? "selected" : "" %>>
        Chicago Bulls
      </option>

      <option value="New York Knicks"
        <%= game.awayTeam === "New York Knicks" ? "selected" : "" %>>
        New York Knicks
      </option>

    </select>


    <label for="date">Date</label>
    <select id="date" name="date">

      <option value="October 21, 2026"
        <%= game.date === "October 21, 2026" ? "selected" : "" %>>
        October 21, 2026
      </option>

      <option value="October 22, 2026"
        <%= game.date === "October 22, 2026" ? "selected" : "" %>>
        October 22, 2026
      </option>

      <option value="October 23, 2026"
        <%= game.date === "October 23, 2026" ? "selected" : "" %>>
        October 23, 2026
      </option>

      <option value="October 24, 2026"
        <%= game.date === "October 24, 2026" ? "selected" : "" %>>
        October 24, 2026
      </option>

      <option value="October 25, 2026"
        <%= game.date === "October 25, 2026" ? "selected" : "" %>>
        October 25, 2026
      </option>

      <option value="October 26, 2026"
        <%= game.date === "October 26, 2026" ? "selected" : "" %>>
        October 26, 2026
      </option>

      <option value="October 27, 2026"
        <%= game.date === "October 27, 2026" ? "selected" : "" %>>
        October 27, 2026
      </option>

      <option value="October 28, 2026"
        <%= game.date === "October 28, 2026" ? "selected" : "" %>>
        October 28, 2026
      </option>

    </select>


    <label for="time">Time</label>
    <select id="time" name="time">

      <option value="7:00 PM"
        <%= game.time === "7:00 PM" ? "selected" : "" %>>
        7:00 PM
      </option>

      <option value="7:30 PM"
        <%= game.time === "7:30 PM" ? "selected" : "" %>>
        7:30 PM
      </option>

      <option value="8:00 PM"
        <%= game.time === "8:00 PM" ? "selected" : "" %>>
        8:00 PM
      </option>

      <option value="8:30 PM"
        <%= game.time === "8:30 PM" ? "selected" : "" %>>
        8:30 PM
      </option>

      <option value="9:00 PM"
        <%= game.time === "9:00 PM" ? "selected" : "" %>>
        9:00 PM
      </option>

      <option value="10:00 PM"
        <%= game.time === "10:00 PM" ? "selected" : "" %>>
        10:00 PM
      </option>

      <option value="10:30 PM"
        <%= game.time === "10:30 PM" ? "selected" : "" %>>
        10:30 PM
      </option>

    </select>


    <label for="arena">Arena</label>
    <select id="arena" name="arena">

      <option value="TD Garden"
        <%= game.arena === "TD Garden" ? "selected" : "" %>>
        TD Garden
      </option>

      <option value="Crypto.com Arena"
        <%= game.arena === "Crypto.com Arena" ? "selected" : "" %>>
        Crypto.com Arena
      </option>

      <option value="Chase Center"
        <%= game.arena === "Chase Center" ? "selected" : "" %>>
        Chase Center
      </option>

      <option value="Kaseya Center"
        <%= game.arena === "Kaseya Center" ? "selected" : "" %>>
        Kaseya Center
      </option>

      <option value="United Center"
        <%= game.arena === "United Center" ? "selected" : "" %>>
        United Center
      </option>

      <option value="Madison Square Garden"
        <%= game.arena === "Madison Square Garden" ? "selected" : "" %>>
        Madison Square Garden
      </option>

    </select>


    <label for="importance">Importance</label>
    <select id="importance" name="importance">

      <option value="High"
        <%= game.importance === "High" ? "selected" : "" %>>
        High
      </option>

      <option value="Medium"
        <%= game.importance === "Medium" ? "selected" : "" %>>
        Medium
      </option>

      <option value="Low"
        <%= game.importance === "Low" ? "selected" : "" %>>
        Low
      </option>

    </select>


    <label for="notes">Notes</label>
    <select id="notes" name="notes">

      <option value="Big game"
        <%= game.notes === "Big game" ? "selected" : "" %>>
        Big game
      </option>

      <option value="Rivalry game"
        <%= game.notes === "Rivalry game" ? "selected" : "" %>>
        Rivalry game
      </option>

      <option value="Regular game"
        <%= game.notes === "Regular game" ? "selected" : "" %>>
        Regular game
      </option>

      <option value="Important game"
        <%= game.notes === "Important game" ? "selected" : "" %>>
        Important game
      </option>

    </select>


    <button type="submit">Update Game</button>

  </form>

</body>

</html>