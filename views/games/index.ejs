<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <title>NBA Games</title>
</head>

<body>

  <div class="index-header-div">

    <h1>Upcoming NBA Games</h1>

    <a class="add-game" href="/games/new">Add Game</a>

  </div>

  <ul>

    <% games.forEach(game => { %>

      <li>

        <a class="game-cards" href="/games/<%= game._id %>">

          <%= game.homeTeam %> vs <%= game.awayTeam %>

        </a>

      </li>

    <% }); %>

  </ul>

</body>

</html>