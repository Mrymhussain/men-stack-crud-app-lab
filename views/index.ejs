<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <title>NBA Game Watchlist</title>
</head>

<body class="home-page">

  <main class="home-content">

    <section class="home-text">
      <h1>
        Welcome to Your
        <span>NBA Game Watchlist</span>
      </h1>

      <p>
        Keep track of the NBA games you don't want to miss.
      </p>

      <a class="games-index-link" href="/games">
        <div class="index-link-text">
          Browse Games
        </div>
      </a>
    </section>

    <section class="logo-section">
      <img
        class="nba-logo"
        src="/stylesheets/nba-logo.png"
        alt="NBA Logo"
      />
    </section>

  </main>

  <footer>NBA Game Watchlist</footer>

</body>

</html>